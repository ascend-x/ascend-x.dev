<div class="flex items-center gap-1.5 text-muted text-sm font-medium mt-2 sm:mt-0" title="Live view count">
	<svg class="h-4 w-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
		<circle cx="12" cy="12" r="3" />
	</svg>
	<span id="stats-views">...</span>
	<span>views</span>
</div>

<script is:inline>
	// GoatCounter automatically populates this when the script loads
	var t = setInterval(function() {
		if (window.goatcounter && window.goatcounter.visit_count) {
			clearInterval(t);
			window.goatcounter.visit_count({
				append: '#stats-views',
				no_branding: true
			});
		}
	}, 100);
</script>
