---
interface Props {
	views?: string | number;
}
const { views } = Astro.props;
---

<div class="flex items-center gap-1.5 text-muted text-sm font-medium mt-2 sm:mt-0" title="Live view count">
	<svg class="h-4 w-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
		<circle cx="12" cy="12" r="3" />
	</svg>
	<span id="stats-views">{views ? views : "..."}</span>
	<span>views</span>
</div>

{!views && (
<script is:inline>
	// Use a clean fetch request instead of the iframe injection to avoid breaking the layout on 403 errors
	async function fetchViews() {
		try {
			// GoatCounter normalizes paths by stripping trailing slashes
			let rawPath = location.pathname.replace(/\/$/, '');
			if (rawPath === '') rawPath = '/';
			
			const path = encodeURIComponent(rawPath);
			const response = await fetch(`https://ascend-x.goatcounter.com/counter/${path}.json`);
			
			if (!response.ok) {
				console.warn('GoatCounter API returned an error.');
				document.getElementById('stats-views').textContent = "0";
				return;
			}
			
			const data = await response.json();
			// GoatCounter returns { count: "1" }
			document.getElementById('stats-views').textContent = data.count || "0";
		} catch (error) {
			console.error("Failed to fetch view count:", error);
			document.getElementById('stats-views').textContent = "0";
		}
	}
	
	// Fetch immediately
	fetchViews();
</script>
)}
