---
import PageLayout from "@/layouts/Base.astro";

import { getCollection } from "astro:content";

const meta = {
	description: "Projects by Nandakishore V — Cybersecurity, Cloud, Blockchain, and AI",
	title: "Projects",
};

const allProjects = await getCollection("project");
// Sort by date if we want, or just use as is (already handled by markdown date)
const projects = allProjects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">Projects</h1>

	<div class="space-y-4">
		{
			projects.map((project) => (
				<div class="project-card relative">
					<a href={`/projects/${project.id}/`} class="absolute inset-0 z-10" aria-label={`Read more about ${project.data.title}`} />
					<div class="flex justify-between items-start">
						<p class="project-title hover:text-accent transition-colors">{project.data.title}</p>
						{project.data.githubUrl && (
							<a href={project.data.githubUrl} target="_blank" rel="noreferrer" class="z-20 text-muted hover:text-accent" aria-label="GitHub Repository">
								<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.699-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.416 22 12c0-5.523-4.477-10-10-10z"/></svg>
							</a>
						)}
					</div>
					<p class="project-desc relative z-20 pointer-events-none">{project.data.description}</p>
					<div class="project-tags relative z-20 pointer-events-none mt-2">
						{project.data.technologies.map((tag) => (
							<span class="skill-badge">{tag}</span>
						))}
					</div>
				</div>
			))
		}
	</div>

	{/* GitHub CTA */}
	<div class="mt-10 text-center">
		<a
			class="cactus-link text-accent inline-flex items-center gap-2 text-sm font-semibold"
			href="https://github.com/ascend-x"
			target="_blank"
			rel="noreferrer"
		>
			20+ more projects on GitHub →
		</a>
	</div>
</PageLayout>
