---
import PageLayout from "@/layouts/Base.astro";
import { getCollection, render } from "astro:content";
import PostPreview from "@/components/blog/PostPreview.astro";

export async function getStaticPaths() {
	const series = await getCollection("series");
	return series.map((s) => ({
		params: { slug: s.id },
		props: { series: s },
	}));
}

const { series } = Astro.props;
const { Content } = await render(series);

const allPosts = await getCollection("post");
const seriesPosts = allPosts
	.filter((post) => post.data.series === series.id)
	.sort((a, b) => a.data.publishDate.valueOf() - b.data.publishDate.valueOf()); // chronologically for playlist

const meta = {
	description: series.data.description,
	title: series.data.title,
};
---

<PageLayout meta={meta}>
	<div class="mb-6">
		<a href="/" class="text-accent hover:underline">← Back to Home</a>
	</div>

	<h1 class="title mb-4 text-3xl">{series.data.title}</h1>
	
	<div class="prose prose-sm prose-cactus max-w-none mb-12">
		<Content />
	</div>

	<h2 class="title mb-6 text-xl flex items-center gap-2">
		<svg class="h-5 w-5 text-accent" viewBox="0 0 24 24" fill="currentColor"><path d="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-5 9l-4 3V7l4 3z"/></svg>
		Playlist
	</h2>

	{seriesPosts.length > 0 ? (
		<ul class="space-y-4">
			{seriesPosts.map((p, i) => (
				<li class="flex flex-col gap-x-2 sm:flex-row">
					<div class="text-accent-2 font-mono min-w-[2rem]">{String(i + 1).padStart(2, '0')}.</div>
					<PostPreview post={p} />
				</li>
			))}
		</ul>
	) : (
		<p class="text-muted italic">No posts in this series yet. Check back later!</p>
	)}
</PageLayout>
