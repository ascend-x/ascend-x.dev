---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "About Nandakishore V — Education, Work Experience, and Technical Skills",
	title: "About",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">About Me</h1>

	{/* ── Overview ── */}
	<section class="mb-16">
		<h2 class="title mb-6 text-xl">Overview</h2>
		<div class="prose prose-sm prose-p:text-muted max-w-none">
			<p>
				Hi, I'm Nandakishore V! I'm a cybersecurity enthusiast who turns caffeine into code and sleep deprivation into secure systems. When I'm not hunting for vulnerabilities or participating in the hundredth CTF of the month, you can probably find me trying to convince my friends that Linux is actually very user-friendly. 
			</p>
			<p>
				My journey into tech started with curiosity and led me straight down the rabbit hole of infosec, cloud engineering, and system administration. I love breaking things just to learn how to build them better, and I'm always looking for the next challenge to tackle!
			</p>
		</div>
	</section>

	{/* ── Skills Grid ── */}
	<section class="mb-16">
		<h2 class="title mb-6 text-xl">Skills & Arsenal</h2>
		<div class="space-y-6">
			<div>
				<h3 class="text-accent-2 mb-2 text-sm font-semibold uppercase tracking-wider">Languages</h3>
				<div class="flex flex-wrap gap-2">
					{["Python", "C++", "Rust", "Bash", "JavaScript", "TypeScript", "SQL"].map((s) => (
						<span class="skill-badge">{s}</span>
					))}
				</div>
			</div>
			<div>
				<h3 class="text-accent-2 mb-2 text-sm font-semibold uppercase tracking-wider">Frameworks & Databases</h3>
				<div class="flex flex-wrap gap-2">
					{["React.js", "Node.js", "Express.js", "Tailwind CSS", "MongoDB", "MySQL", "Flutter", "Astro"].map((s) => (
						<span class="skill-badge">{s}</span>
					))}
				</div>
			</div>
			<div>
				<h3 class="text-accent-2 mb-2 text-sm font-semibold uppercase tracking-wider">Security Tools</h3>
				<div class="flex flex-wrap gap-2">
					{["Burp Suite", "Metasploit", "Nmap", "Wireshark", "Active Directory", "BloodHound", "Ghidra", "SQLmap", "Nessus"].map((s) => (
						<span class="skill-badge">{s}</span>
					))}
				</div>
			</div>
			<div>
				<h3 class="text-accent-2 mb-2 text-sm font-semibold uppercase tracking-wider">Cloud & DevOps</h3>
				<div class="flex flex-wrap gap-2">
					{["GCP", "AWS", "Docker", "Kubernetes", "Terraform", "Linux / RHEL", "CI/CD", "Git"].map((s) => (
						<span class="skill-badge">{s}</span>
					))}
				</div>
			</div>
			<div>
				<h3 class="text-accent-2 mb-2 text-sm font-semibold uppercase tracking-wider">Platforms & Labs</h3>
				<div class="flex flex-wrap gap-2">
					{["TryHackMe", "HackTheBox", "HackTricks", "CyberDefenders"].map((s) => (
						<span class="skill-badge">{s}</span>
					))}
				</div>
			</div>
		</div>
	</section>

	{/* ── Work Experience ── */}
	<section class="mb-16">
		<h2 class="title mb-6 text-xl">Work Experience</h2>
		<div class="space-y-4">
			<div class="experience-card">
				<div class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between">
					<p class="exp-role">System Administrator</p>
					<p class="exp-date">Aug 2025 – Present</p>
				</div>
				<p class="exp-org">SRMIST, Tiruchirappalli</p>
				<div class="exp-details">
					<p>• Managing an EDA tools portfolio worth ₹2 Cr across the department, ensuring smooth operations for thousands of students.</p>
					<p>• Successfully migrated 40+ workstations to RHEL 8.1, optimizing system performance and achieving 99.9% uptime.</p>
					<p>• Authored extensive internal documentation for network policies and incident response protocols.</p>
				</div>
			</div>

			<div class="experience-card">
				<div class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between">
					<p class="exp-role">Idea Validation Coordinator</p>
					<p class="exp-date">Apr 2025 – Present</p>
				</div>
				<p class="exp-org">IIC SRMIST</p>
				<div class="exp-details">
					<p>• Screened over 600 innovation projects for technical feasibility, market viability, and security compliance.</p>
					<p>• Guided 80% of the screened projects successfully to the prototype stage through dedicated mentorship.</p>
					<p>• Advised 50+ student founders on technical architecture, scalability, and go-to-market strategies.</p>
				</div>
			</div>

			<div class="experience-card">
				<div class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between">
					<p class="exp-role">GCP Cloud Engineer Intern</p>
					<p class="exp-date">Jul – Oct 2025</p>
				</div>
				<p class="exp-org">DC Infotech & Communication</p>
				<div class="exp-details">
					<p>• Achieved a massive 40% latency reduction through aggressive infrastructure and routing optimization.</p>
					<p>• Maintained strict 99.9% uptime SLAs across 3 major client-facing cloud environments.</p>
					<p>• Deployed production workloads securely on GCP using Terraform (IaC) and Kubernetes (GKE).</p>
				</div>
			</div>

			<div class="experience-card">
				<div class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between">
					<p class="exp-role">Community Manager</p>
					<p class="exp-date">Apr 2025 – Present</p>
				</div>
				<p class="exp-org">DarkLead!</p>
				<div class="exp-details">
					<p>• Built and managed scalable, secure CTF infrastructure handling traffic from 800+ competing teams globally.</p>
					<p>• Directed community engagement, secured industry sponsorships, and handled all external communications.</p>
				</div>
			</div>

			<div class="experience-card">
				<div class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between">
					<p class="exp-role">Event Manager</p>
					<p class="exp-date">Oct 2024 – Aug 2025</p>
				</div>
				<p class="exp-org">CyberAnzen, SRMIST</p>
				<div class="exp-details">
					<p>• Orchestrated and hosted 10+ major cybersecurity workshops, bootcamps, and CTF events on campus.</p>
					<p>• Consistently engaged 500+ active participants, driving a 60% year-over-year growth in club membership.</p>
				</div>
			</div>
		</div>
	</section>

	{/* ── Education Timeline ── */}
	<section class="mb-16">
		<h2 class="title mb-6 text-xl">Education</h2>
		<div class="timeline">
			<div class="timeline-item">
				<p class="text-accent-2 font-semibold">B.Tech Computer Science & Engineering (Cybersecurity)</p>
				<p class="text-accent text-sm font-medium">SRMIST, Tiruchirappalli</p>
				<p class="text-muted text-xs">Aug 2024 – Present</p>
				<p class="text-muted mt-2 text-sm">Focusing on cryptography, network security, ethical hacking, and cloud computing. Active member of technical clubs and hackathon squads.</p>
			</div>
			<div class="timeline-item">
				<p class="text-accent-2 font-semibold">12th Grade (CBSE)</p>
				<p class="text-accent text-sm font-medium">Guru Teg Bahadur Public School</p>
				<p class="text-muted text-xs">Graduated 2024</p>
				<p class="text-muted mt-2 text-sm">Computer Science track. Graduated with distinction and served as the technical lead for school IT events.</p>
			</div>
			<div class="timeline-item">
				<p class="text-accent-2 font-semibold">10th Grade (CBSE)</p>
				<p class="text-accent text-sm font-medium">Guru Teg Bahadur Public School</p>
				<p class="text-muted text-xs">Graduated 2022</p>
			</div>
		</div>
	</section>
</PageLayout>
