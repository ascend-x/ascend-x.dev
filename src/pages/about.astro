---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "About Nandakishore V — Education, Work Experience, and Technical Skills",
	title: "About",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">About</h1>

	{/* ── Education Timeline ── */}
	<section class="mb-16">
		<h2 class="title mb-6 text-xl">Education</h2>
		<div class="timeline">
			<div class="timeline-item">
				<p class="text-accent-2 font-semibold">B.Tech CSE — Cybersecurity</p>
				<p class="text-accent text-sm font-medium">SRMIST, Tiruchirappalli</p>
				<p class="text-muted text-xs">Aug 2024 – Present</p>
			</div>
			<div class="timeline-item">
				<p class="text-accent-2 font-semibold">12th Grade (CBSE)</p>
				<p class="text-accent text-sm font-medium">Guru Teg Bahadur Public School</p>
				<p class="text-muted text-xs">2024</p>
			</div>
			<div class="timeline-item">
				<p class="text-accent-2 font-semibold">10th Grade (CBSE)</p>
				<p class="text-accent text-sm font-medium">Guru Teg Bahadur Public School</p>
				<p class="text-muted text-xs">2022</p>
			</div>
		</div>
	</section>

	{/* ── Work Experience ── */}
	<section class="mb-16">
		<h2 class="title mb-6 text-xl">Work Experience</h2>
		<div class="space-y-4">
			<div class="experience-card">
				<div class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between">
					<p class="exp-role">System Administrator</p>
					<p class="exp-date">Aug 2025 – Present</p>
				</div>
				<p class="exp-org">SRMIST, Tiruchirappalli</p>
				<div class="exp-details">
					<p>• Managing EDA tools portfolio worth ₹2 Cr across the department</p>
					<p>• Migrated 40+ workstations to RHEL 8.1, ensuring seamless uptime</p>
				</div>
			</div>

			<div class="experience-card">
				<div class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between">
					<p class="exp-role">Idea Validation Coordinator</p>
					<p class="exp-date">Apr 2025 – Present</p>
				</div>
				<p class="exp-org">IIC SRMIST</p>
				<div class="exp-details">
					<p>• Screened 600+ innovation projects for feasibility and impact</p>
					<p>• Guided 80% of screened projects to prototype stage</p>
					<p>• Advised 50+ student founders on technical and business strategy</p>
				</div>
			</div>

			<div class="experience-card">
				<div class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between">
					<p class="exp-role">GCP Cloud Engineer Intern</p>
					<p class="exp-date">Jul – Oct 2025</p>
				</div>
				<p class="exp-org">DC Infotech & Communication</p>
				<div class="exp-details">
					<p>• Achieved 40% latency reduction through infrastructure optimisation</p>
					<p>• Maintained 99.9% uptime across 3 client-facing cloud projects</p>
					<p>• Deployed production workloads on GCP with Terraform & Kubernetes</p>
				</div>
			</div>

			<div class="experience-card">
				<div class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between">
					<p class="exp-role">Community Manager</p>
					<p class="exp-date">Apr 2025 – Present</p>
				</div>
				<p class="exp-org">DarkLead!</p>
				<div class="exp-details">
					<p>• Built and managed CTF infrastructure for 800+ team competitions</p>
					<p>• Secured sponsorships and handled external communications</p>
				</div>
			</div>

			<div class="experience-card">
				<div class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between">
					<p class="exp-role">Event Manager</p>
					<p class="exp-date">Oct 2024 – Aug 2025</p>
				</div>
				<p class="exp-org">CyberAnzen, SRMIST</p>
				<div class="exp-details">
					<p>• Organised 10+ cybersecurity workshops and CTF events</p>
					<p>• Engaged 500+ participants with 60% year-over-year growth</p>
				</div>
			</div>
		</div>
	</section>

	{/* ── Skills Grid ── */}
	<section class="mb-16">
		<h2 class="title mb-6 text-xl">Skills</h2>
		<div class="space-y-6">
			<div>
				<h3 class="text-accent-2 mb-2 text-sm font-semibold uppercase tracking-wider">Languages</h3>
				<div class="flex flex-wrap gap-2">
					{["Python", "C++", "Rust", "Bash"].map((s) => (
						<span class="skill-badge">{s}</span>
					))}
				</div>
			</div>
			<div>
				<h3 class="text-accent-2 mb-2 text-sm font-semibold uppercase tracking-wider">Frameworks & Databases</h3>
				<div class="flex flex-wrap gap-2">
					{["React.js", "Node.js", "Express.js", "Tailwind CSS", "MongoDB", "MySQL", "Flutter"].map((s) => (
						<span class="skill-badge">{s}</span>
					))}
				</div>
			</div>
			<div>
				<h3 class="text-accent-2 mb-2 text-sm font-semibold uppercase tracking-wider">Security Tools</h3>
				<div class="flex flex-wrap gap-2">
					{["Burp Suite", "Metasploit", "Nmap", "Wireshark", "Active Directory", "BloodHound", "Ghidra", "SQLmap"].map((s) => (
						<span class="skill-badge">{s}</span>
					))}
				</div>
			</div>
			<div>
				<h3 class="text-accent-2 mb-2 text-sm font-semibold uppercase tracking-wider">Cloud & DevOps</h3>
				<div class="flex flex-wrap gap-2">
					{["GCP", "Docker", "Kubernetes", "Terraform", "Linux", "CI/CD", "Blockchain", "IoT"].map((s) => (
						<span class="skill-badge">{s}</span>
					))}
				</div>
			</div>
			<div>
				<h3 class="text-accent-2 mb-2 text-sm font-semibold uppercase tracking-wider">Platforms</h3>
				<div class="flex flex-wrap gap-2">
					{["TryHackMe", "HackTheBox", "HackTricks"].map((s) => (
						<span class="skill-badge">{s}</span>
					))}
				</div>
			</div>
		</div>
	</section>
</PageLayout>
