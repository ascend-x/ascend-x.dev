---
import { Icon } from "astro-icon/components";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Admin dashboard — Manage your portfolio content",
	title: "Admin",
};

const GITHUB_REPO = "https://github.com/ascend-x/ascend-x.dev";

const sections = [
	{
		title: "Blog Posts",
		icon: "mdi:file-document-edit",
		description: "Write cybersecurity writeups, CTF walkthroughs, and technical articles.",
		path: "src/content/post/",
		editUrl: `${GITHUB_REPO}/tree/main/src/content/post`,
		format: "---\n" +
			"title: \"Your Post Title\"\n" +
			"description: \"Brief description\"\n" +
			"publishDate: \"2026-01-01\"\n" +
			"tags: [\"cybersecurity\", \"ctf\"]\n" +
			"draft: false\n" +
			"pinned: false\n" +
			"---\n\n" +
			"Your markdown content here...",
	},
	{
		title: "Featured Series (Playlists)",
		icon: "mdi:playlist-play",
		description: "Create a new series to group multiple blog posts together.",
		path: "src/content/series/",
		editUrl: `${GITHUB_REPO}/tree/main/src/content/series`,
		format: "---\n" +
			"title: \"Series Name\"\n" +
			"description: \"Brief overview...\"\n" +
			"---\n\n" +
			"Your series description here.\n\n" +
			"(To add a post to this series, add 'series: \"filename\"' to the post's frontmatter!)",
	},
	{
		title: "Projects",
		icon: "mdi:code-braces",
		description: "Add or edit project case studies.",
		path: "src/content/project/",
		editUrl: `${GITHUB_REPO}/tree/main/src/content/project`,
		format: "---\n" +
			"title: \"Project Name\"\n" +
			"description: \"What it does...\"\n" +
			"date: 2026-06-02\n" +
			"technologies: [\"Tag1\", \"Tag2\"]\n" +
			"githubUrl: \"https://github.com/...\"\n" +
			"---\n\n" +
			"Full project writeup goes here...",
	},
	{
		title: "Achievements",
		icon: "mdi:trophy",
		description: "Add hackathon wins, CTF placements, and certifications.",
		path: "src/pages/achievements/index.astro",
		editUrl: `${GITHUB_REPO}/blob/main/src/pages/achievements/index.astro`,
		format: "// Add to the relevant array:\n" +
			"{\n" +
			"  medal: \"🥇\",\n" +
			"  title: \"Event Name\",\n" +
			"  org: \"Organisation\",\n" +
			"  date: \"Month Year\",\n" +
			"  detail: \"Optional detail\",\n" +
			"}",
	},
	{
		title: "Experience & About",
		icon: "mdi:briefcase",
		description: "Update work experience, education, and skills on the about page.",
		path: "src/pages/about.astro",
		editUrl: `${GITHUB_REPO}/blob/main/src/pages/about.astro`,
		format: null,
	},
	{
		title: "Site Configuration",
		icon: "mdi:cog",
		description: "Update site title, description, author, URL, and navigation links.",
		path: "src/site.config.ts",
		editUrl: `${GITHUB_REPO}/blob/main/src/site.config.ts`,
		format: null,
	},
];
---

<PageLayout meta={meta}>
	<h1 class="title mb-4">Admin Dashboard</h1>
	<p class="text-muted mb-10 text-sm">
		Manage your portfolio content. Edit files directly on GitHub — changes auto-deploy on push.
	</p>

	{/* Analytics Section */}
	<section class="mb-12">
		<h2 class="title mb-6 text-xl">Analytics</h2>
		<div class="rounded-lg border border-accent/30 bg-accent/5 p-5 shadow-sm">
			<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div>
					<div class="flex items-center gap-2">
						<Icon aria-hidden="true" class="h-6 w-6 text-accent" focusable="false" name="mdi:google-analytics" />
						<h3 class="text-accent font-semibold text-lg">Google Analytics 4</h3>
					</div>
					<p class="text-muted text-sm mt-1">Track live visitors, page views, and blog readership metrics.</p>
					<p class="text-muted text-xs mt-2 font-mono">Currently tracking with ID: G-VVK02C78YX</p>
				</div>
				<a href="https://analytics.google.com/" target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 rounded-md bg-accent px-4 py-2 text-sm font-semibold text-global-bg transition-colors hover:bg-accent/90">
					View Dashboard
					<span aria-hidden="true">→</span>
				</a>
			</div>
		</div>
	</section>

	<h2 class="title mb-6 text-xl">Content Management</h2>
	<div class="space-y-6">
		{
			sections.map((section) => (
				<div class="admin-card">
					<div class="flex items-start gap-3">
						<Icon
							aria-hidden="true"
							class="h-6 w-6 flex-shrink-0 text-accent mt-0.5"
							focusable="false"
							name={section.icon}
						/>
						<div class="flex-1">
							<div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
								<p class="text-accent-2 font-semibold">{section.title}</p>
								<a
									class="cactus-link text-accent text-xs font-medium"
									href={section.editUrl}
									target="_blank"
									rel="noreferrer"
								>
									Edit on GitHub →
								</a>
							</div>
							<p class="text-muted mt-1 text-sm">{section.description}</p>
							<p class="text-muted mt-1 font-mono text-xs opacity-60">{section.path}</p>
							{section.format && (
								<details class="mt-3">
									<summary class="text-accent cursor-pointer text-xs font-medium">
										View content format
									</summary>
									<pre class="bg-global-text/5 mt-2 overflow-x-auto rounded p-3 text-xs leading-relaxed">
										<code>{section.format}</code>
									</pre>
								</details>
							)}
						</div>
					</div>
				</div>
			))
		}
	</div>

	{/* Quick Actions */}
	<section class="mt-12">
		<h2 class="title mb-6 text-xl">Quick Actions</h2>
		<div class="flex flex-wrap gap-3">
			<a
				class="quick-nav-link"
				href={`${GITHUB_REPO}/new/main/src/content/post`}
				target="_blank"
				rel="noreferrer"
			>
				<Icon aria-hidden="true" class="h-4 w-4" focusable="false" name="mdi:plus" />
				New Blog Post
			</a>
			<a
				class="quick-nav-link"
				href={`${GITHUB_REPO}/new/main/src/content/project`}
				target="_blank"
				rel="noreferrer"
			>
				<Icon aria-hidden="true" class="h-4 w-4" focusable="false" name="mdi:plus" />
				New Project
			</a>
			<a
				class="quick-nav-link"
				href={`${GITHUB_REPO}/new/main/src/content/series`}
				target="_blank"
				rel="noreferrer"
			>
				<Icon aria-hidden="true" class="h-4 w-4" focusable="false" name="mdi:plus" />
				New Series
			</a>
			<a
				class="quick-nav-link"
				href={GITHUB_REPO}
				target="_blank"
				rel="noreferrer"
			>
				<Icon aria-hidden="true" class="h-4 w-4" focusable="false" name="mdi:github" />
				Open Repository
			</a>
		</div>
	</section>
</PageLayout>

<script>
	// Simple client-side security gate to prevent random visitors from accessing the admin panel
	const gate = document.createElement('div');
	gate.style.position = 'fixed';
	gate.style.inset = '0';
	gate.style.backgroundColor = '#0F111A';
	gate.style.zIndex = '9999';
	gate.style.display = 'flex';
	gate.style.flexDirection = 'column';
	gate.style.alignItems = 'center';
	gate.style.justifyContent = 'center';
	gate.style.fontFamily = 'monospace';
	gate.innerHTML = `
		<svg style="width: 48px; height: 48px; color: #D93B3F; margin-bottom: 16px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
		<h1 style="color: #D93B3F; font-size: 20px; font-weight: bold; margin-bottom: 24px; letter-spacing: 2px;">AUTHORIZATION REQUIRED</h1>
		<input type="password" id="admin-pass" placeholder="Enter Passcode" style="padding: 12px 16px; border-radius: 6px; background: #1A1D27; border: 1px solid #D93B3F; color: white; outline: none; width: 250px; text-align: center; font-size: 16px;" autofocus autocomplete="off" />
		<p id="admin-err" style="color: red; font-size: 12px; margin-top: 12px; opacity: 0; transition: opacity 0.3s;">ACCESS DENIED</p>
	`;

	if (sessionStorage.getItem('admin_clearance') !== 'granted') {
		document.body.appendChild(gate);
		document.body.style.overflow = 'hidden';

		const input = document.getElementById('admin-pass');
		const err = document.getElementById('admin-err');
		
		input?.addEventListener('keydown', (e) => {
			if (e.key === 'Enter') {
				if ((e.target as HTMLInputElement).value === 'ascendx') {
					sessionStorage.setItem('admin_clearance', 'granted');
					gate.style.opacity = '0';
					gate.style.transition = 'opacity 0.5s';
					setTimeout(() => {
						gate.remove();
						document.body.style.overflow = 'auto';
					}, 500);
				} else {
					if (err) err.style.opacity = '1';
					(e.target as HTMLInputElement).value = '';
					setTimeout(() => { if (err) err.style.opacity = '0'; }, 2000);
				}
			}
		});
	}
</script>
